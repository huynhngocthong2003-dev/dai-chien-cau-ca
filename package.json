{
  "name": "dai-chien-cau-ca",
  "private": true,
  "version": "0.36.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @dccc/game-client dev",
    "build": "pnpm --filter @dccc/game-client build",
    "build:single": "pnpm --filter @dccc/game-client build:single",
    "preview": "pnpm --filter @dccc/game-client preview",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/smoke.mjs && node tests/e2e/shop.cjs && node tests/e2e/giftcode.cjs && node tests/e2e/fashion.cjs && node tests/e2e/eco.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:artifact": "pnpm build:single && node scripts/make-artifact.mjs",
    "test:db": "bash tests/db/run.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12",
    "@dccc/shared": "workspace:*",
    "@dccc/game-data": "workspace:*",
    "@dccc/game-config": "workspace:*",
    "@dccc/validation": "workspace:*"
  }
}
